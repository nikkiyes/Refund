# ─────────────────────────────────────────────────────────────────
#  Pareeksha Gurukul Refund Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────
# Your Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated list of super-admin Telegram user IDs
# Get your ID from @userinfobot
ADMIN_IDS=123456789,987654321

# Telegram group/channel ID where refund requests are sent
# Use a negative number for groups, e.g. -1001234567890
# Add the bot as admin in the group first!
ADMIN_GROUP_ID=-1001234567890

# ── OPTIONAL ──────────────────────────────────────────────────────
# Path to SQLite database file (default: data/pg_refund.db)
DB_PATH=data/pg_refund.db

# Rate limiting: minimum seconds between messages per user
RATE_LIMIT_SECONDS=3

# Support contact shown in help messages
SUPPORT_CONTACT=@PareekshaGurukul
